# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/secure_evoting
# Railway MongoDB provides MONGO_URL by default. The app accepts either MONGO_URI or MONGO_URL.
# MONGO_URL=mongodb://mongo:password@host:port/secure_evoting
# Optional: database name to use when the Mongo URI does not include one.
# MONGO_DB_NAME=secure_evoting
# Optional: DNS servers for mongodb+srv:// lookup if your local DNS blocks SRV records.
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1
# Optional: fail fast if MongoDB is unreachable.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/secure_evoting

# JWT Secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024

# Server
PORT=5000
NODE_ENV=development

# Email (for OTP - use Gmail App Password)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Admin Setup
ADMIN_EMAIL=admin@evoting.com
ADMIN_PASSWORD=Admin@123
DEMO_VOTER_EMAIL=rahul@example.com
DEMO_VOTER_PASSWORD=Voter@123
